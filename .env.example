# Database URL
# Local SQLite: file:./dev.db
# Production (Vercel/Render): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="file:./dev.db"

# 1. Google Maps API Key (Powers Google Places Search, Geocoding & SDK)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# 2. Weather API Keys (OpenWeather API)
OPENWEATHER_API_KEY="your_openweather_api_key_here"
NEXT_PUBLIC_OPENWEATHER_API_KEY="your_openweather_api_key_here"

