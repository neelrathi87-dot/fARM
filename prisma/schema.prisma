datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Field {
  id             String         @id @default(uuid())
  name           String         @unique
  cropType       String
  areaAcres      Float
  latitude       Float
  longitude      Float
  polygonGeoJson String?
  createdAt      DateTime       @default(now())
  
  waterLogs      WaterLog[]
  pesticideLogs  PesticideLog[]
  dailyExpenses  DailyExpense[]

  @@index([cropType])
}

model WaterLog {
  id              String   @id @default(uuid())
  fieldId         String
  field           Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String
  endTime         String
  durationMinutes Int
  waterType       String   // NORMAL_WATER, LIQUID_WATER
  deliveryMethod  String   // DRIP, SPRINKLER, FLOOD
  motorHp         Float    @default(5.0)
  flowRateLpm     Float    @default(750.0)
  volumeLiters    Float
  notes           String?
  createdAt       DateTime @default(now())

  @@index([fieldId])
  @@index([date])
}

model PesticideLog {
  id                String   @id @default(uuid())
  fieldId           String
  field             Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  date              DateTime
  timestamp         DateTime @default(now())
  chemicalName      String
  targetPest        String
  formulationType   String   // LIQUID, DRY_POWDER
  dosageRate        Float
  dosageUnit        String   // ML_PER_L, L_PER_L, G_PER_L, KG_PER_L
  sprayVolumeLiters Float
  netChemicalAmount Float
  netChemicalUnit   String   // mL, L, g, kg
  applicationMethod String   // FOLIAR, DRENCH, FERTIGATION
  createdAt         DateTime @default(now())

  @@index([fieldId])
  @@index([chemicalName])
  @@index([date])
}

model DailyExpense {
  id          String   @id @default(uuid())
  fieldId     String?
  field       Field?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  date        DateTime
  category    String   // LABOUR, PESTICIDES, FUEL, MAINTENANCE, OTHER
  amount      Float
  quantity    Float?
  unitRate    Float?
  description String
  createdAt   DateTime @default(now())

  @@index([fieldId])
  @@index([category])
  @@index([date])
}
